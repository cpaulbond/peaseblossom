$ ! vax-tasks-events (doc/developer/tasks.md, Phase 10): poc's runtime and
$ ! Coroutines' switch, COROUTINESWITCH.MAR, are assembled; TASKEVENTS.COM,
$ ! which poc -build wrote, links the program with the switch by its -link
$ ! line, and it runs, spawning TASKWRITER.COM, its SYS$ERROR, where a
$ ! trap's message goes, a file shown after the run. Everything made is
$ ! deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @TASKEVENTS
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ DEFINE/USER_MODE SYS$ERROR TASKEVENTS.ERR
$ RUN TASKEVENTS
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$SEARCH("TASKEVENTS.ERR") .NES. "" THEN TYPE TASKEVENTS.ERR
$ IF F$SEARCH("TASKEVENTS.ERR") .NES. "" THEN DELETE/NOLOG TASKEVENTS.ERR;*
$CLEAN:
$ I = 0
$NEXT_OBJECT:
$ M = F$ELEMENT(I, ",", "POCRTL,COROUTINESWITCH,TASKEVENTS,TASKS,TASKWAITING,COROUTINES,GARBAGECOLLECTEDHEAP,OUT,LINEOUTPUT,FORMATTEDOUTPUT,FORMATTEDTEXT,REALDIGITS")
$ IF M .EQS. "," THEN GOTO DONE
$ IF F$SEARCH("''M'.OBJ") .NES. "" THEN DELETE/NOLOG 'M'.OBJ;*
$ I = I + 1
$ GOTO NEXT_OBJECT
$DONE:
$ IF F$SEARCH("TASKEVENTS.OPT") .NES. "" THEN DELETE/NOLOG TASKEVENTS.OPT;*
$ IF F$SEARCH("TASKEVENTS.EXE") .NES. "" THEN DELETE/NOLOG TASKEVENTS.EXE;*
$ EXIT 1
