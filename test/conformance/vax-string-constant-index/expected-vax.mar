;; Written by Claude, 2026-11-19, for indexing a string constant
;; (doc/developer/language-extensions.md, "Indexing a string constant");
;; reviewed by the user, 2026-11-19. Why this is right:
;; - A string constant of m characters indexed with a variable is selected
;;   from its ARRAY m+1 OF CHAR in POC_CONST, L_CONST_<n>, as a structured
;;   constant is (bug 31, vax-structured-constant-index): its characters
;;   and the 0X after them, L_CONST_1 for digits (17 bytes) and L_CONST_2
;;   for vowels (6), each once however often it is used; an element in
;;   index mode, MOVZBL L_CONST_1[R0] (Digit), CMPB L_CONST_2[R0] (Vowels).
;; - Each index is checked as a variable's is, against the array's last
;;   index, which is m (CMPL R0, #16; CMPL R0, #5), trap 2 at its line
;;   and column.
;; - A constant index and LEN of a string constant fold (Folded:
;;   ORD("F") + 0 + 0 + 17 + 1 = 88), and empty, used only there, has no
;;   storage.
; StringTables, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	STRINGTABLES
	.IDENT	/73538fbe6fbba982/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/StringTables/

; its structured constants
	.PSECT	POC_CONST
	.ALIGN	QUAD
L_CONST_1:
	.ASCII	/0123456789ABCDEF/
	.BYTE	0
	.ALIGN	QUAD
L_CONST_2:
	.ASCII	/aeiou/
	.BYTE	0

; the module's procedures
	.PSECT	POC_CODE
; PROCEDURE Digit
