$ ! vax-tasks-time (doc/developer/tasks.md, Phase 10): poc's runtime and
$ ! Coroutines' switch, COROUTINESWITCH.MAR, are assembled; TASKTIMES.COM,
$ ! which poc -build wrote, links the program with the switch by its -link
$ ! line, and it runs, its SYS$ERROR, where a trap's message goes, a file
$ ! shown after the run. Everything made is deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @TASKTIMES
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ DEFINE/USER_MODE SYS$ERROR TASKTIMES.ERR
$ RUN TASKTIMES
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$SEARCH("TASKTIMES.ERR") .NES. "" THEN TYPE TASKTIMES.ERR
$ IF F$SEARCH("TASKTIMES.ERR") .NES. "" THEN DELETE/NOLOG TASKTIMES.ERR;*
$CLEAN:
$ I = 0
$NEXT_OBJECT:
$ M = F$ELEMENT(I, ",", "POCRTL,COROUTINESWITCH,TASKTIMES,TASKS,TASKWAITING,COROUTINES,GARBAGECOLLECTEDHEAP,ASYNCHRONOUSTRAPS,STARLET,TIMERS,PLATFORM,OUT,LINEOUTPUT,FORMATTEDOUTPUT,FORMATTEDTEXT,REALDIGITS")
$ IF M .EQS. "," THEN GOTO DONE
$ IF F$SEARCH("''M'.OBJ") .NES. "" THEN DELETE/NOLOG 'M'.OBJ;*
$ I = I + 1
$ GOTO NEXT_OBJECT
$DONE:
$ IF F$SEARCH("TASKTIMES.OPT") .NES. "" THEN DELETE/NOLOG TASKTIMES.OPT;*
$ IF F$SEARCH("TASKTIMES.EXE") .NES. "" THEN DELETE/NOLOG TASKTIMES.EXE;*
$ EXIT 1
