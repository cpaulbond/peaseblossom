$ ! vax-tasks-examples (doc/developer/tasks.md, Phase 12): poc's runtime
$ ! and Coroutines' switch, COROUTINESWITCH.MAR, are assembled; then
$ ! PRIMES.COM, CLOCK.COM and CLOCKFEEDER.COM, which poc -build wrote, link
$ ! the programs. PRIMES and CLOCK run as foreign commands, as the User's
$ ! Guide says: PRIMES with the guide's counts (200, not 1000, for its last
$ ! line: a page-file quota), CLOCK with commands from a file and, through
$ ! CLOCKFEEDER, from a mailbox written at the guide's times. Everything
$ ! made is deleted.
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @PRIMES
$ IF S THEN S = $STATUS
$ IF S THEN @CLOCK
$ IF S THEN S = $STATUS
$ IF S THEN @CLOCKFEEDER
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ PRIMES :== $SYS$LOGIN:PRIMES.EXE
$ CLOCK :== $SYS$LOGIN:CLOCK.EXE
$ WRITE SYS$OUTPUT "$ primes 5"
$ PRIMES 5
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ WRITE SYS$OUTPUT "$ primes"
$ PRIMES
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ WRITE SYS$OUTPUT "$ primes 200, its last line"
$ DEFINE/USER_MODE SYS$OUTPUT PRIMES.LIS
$ PRIMES 200
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ LAST = ""
$ OPEN/READ LIST PRIMES.LIS
$READ_PRIME:
$ READ/END_OF_FILE=PRIMES_READ LIST LINE
$ LAST = LINE
$ GOTO READ_PRIME
$PRIMES_READ:
$ CLOSE LIST
$ WRITE SYS$OUTPUT LAST
$ WRITE SYS$OUTPUT "$ clock, from commands.txt"
$ DEFINE/USER_MODE SYS$INPUT COMMANDS.TXT
$ CLOCK
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ WRITE SYS$OUTPUT "$ clock 2, from a mailbox written at the guide's times"
$ RUN CLOCKFEEDER
$ WRITE SYS$OUTPUT "feeder status: ", $STATUS
$ IF F$SEARCH("CLOCK.LOG") .NES. "" THEN TYPE CLOCK.LOG
$ DELETE/SYMBOL/GLOBAL PRIMES
$ DELETE/SYMBOL/GLOBAL CLOCK
$CLEAN:
$ I = 0
$NEXT_OBJECT:
$ M = F$ELEMENT(I, ",", "POCRTL,COROUTINESWITCH,PRIMES,CLOCK,CLOCKFEEDER,TASKS,TASKWAITING,TASKINPUT,COROUTINES,GARBAGECOLLECTEDHEAP,PLATFORM,LINEOUTPUT,FORMATTEDINPUT,DECIMALTOREAL,MODULES,ARGS,OUT,FORMATTEDOUTPUT,FORMATTEDTEXT,REALDIGITS")
$ IF M .EQS. "," THEN GOTO DONE
$ IF F$SEARCH("''M'.OBJ") .NES. "" THEN DELETE/NOLOG 'M'.OBJ;*
$ I = I + 1
$ GOTO NEXT_OBJECT
$DONE:
$ I = 0
$NEXT_FILE:
$ F = F$ELEMENT(I, ",", "PRIMES.OPT,PRIMES.EXE,CLOCK.OPT,CLOCK.EXE,CLOCKFEEDER.OPT,CLOCKFEEDER.EXE,PRIMES.LIS,CLOCK.LOG,COMMANDS.TXT")
$ IF F .EQS. "," THEN GOTO FILES_DONE
$ IF F$SEARCH(F) .NES. "" THEN DELETE/NOLOG 'F';*
$ I = I + 1
$ GOTO NEXT_FILE
$FILES_DONE:
$ EXIT 1
