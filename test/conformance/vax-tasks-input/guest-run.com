$ ! vax-tasks-input (doc/developer/tasks.md, Phase 11): poc's runtime and
$ ! Coroutines' switch, COROUTINESWITCH.MAR, are assembled; TASKREADIN.COM
$ ! and TASKFEEDER.COM, which poc -build wrote, link the programs.
$ ! TASKREADIN reads by TaskInput, in the mode the symbol TASKINPUT_MODE
$ ! names: from disk files and NL:, read by RMS (Platform.Read), and from
$ ! the mailbox TASKFEEDER makes and writes slowly, read by $QIO, with
$ ! TASKREADIN.LOG as its output, shown after the run. Everything made is
$ ! deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @TASKREADIN
$ IF S THEN S = $STATUS
$ IF S THEN @TASKFEEDER
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ CREATE TASKINPUT_LINES.TXT
alpha
beta
gamma
$ CREATE TASKINPUT_SHORT.TXT
abcdefghijklmnop
xy

last, with no line end
$ CREATE TASKINPUT_CHARS.TXT
ab
cd

e
$ CREATE TASKINPUT_TWO.TXT
one
two
three
four
five
six
$ WRITE SYS$OUTPUT "-- lines, from a file"
$ TASKINPUT_MODE = "LINES"
$ DEFINE/USER_MODE SYS$INPUT TASKINPUT_LINES.TXT
$ RUN TASKREADIN
$ WRITE SYS$OUTPUT "-- lines, from NL:"
$ DEFINE/USER_MODE SYS$INPUT NL:
$ RUN TASKREADIN
$ WRITE SYS$OUTPUT "-- short"
$ TASKINPUT_MODE = "SHORT"
$ DEFINE/USER_MODE SYS$INPUT TASKINPUT_SHORT.TXT
$ RUN TASKREADIN
$ WRITE SYS$OUTPUT "-- chars"
$ TASKINPUT_MODE = "CHARS"
$ DEFINE/USER_MODE SYS$INPUT TASKINPUT_CHARS.TXT
$ RUN TASKREADIN
$ WRITE SYS$OUTPUT "-- two"
$ TASKINPUT_MODE = "TWO"
$ DEFINE/USER_MODE SYS$INPUT TASKINPUT_TWO.TXT
$ RUN TASKREADIN
$ WRITE SYS$OUTPUT "-- ticks, from a mailbox written slowly"
$ TASKINPUT_MODE = "TICKS"
$ RUN TASKFEEDER
$ WRITE SYS$OUTPUT "feeder status: ", $STATUS
$ IF F$SEARCH("TASKREADIN.LOG") .NES. "" THEN TYPE TASKREADIN.LOG
$ DELETE/SYMBOL/LOCAL TASKINPUT_MODE
$CLEAN:
$ I = 0
$NEXT_OBJECT:
$ M = F$ELEMENT(I, ",", "POCRTL,COROUTINESWITCH,TASKREADIN,TASKFEEDER,TASKINPUT,TASKS,TASKWAITING,COROUTINES,GARBAGECOLLECTEDHEAP,PLATFORM,LINEOUTPUT,FORMATTEDINPUT,DECIMALTOREAL,OUT,FORMATTEDOUTPUT,FORMATTEDTEXT,REALDIGITS")
$ IF M .EQS. "," THEN GOTO DONE
$ IF F$SEARCH("''M'.OBJ") .NES. "" THEN DELETE/NOLOG 'M'.OBJ;*
$ I = I + 1
$ GOTO NEXT_OBJECT
$DONE:
$ I = 0
$NEXT_FILE:
$ F = F$ELEMENT(I, ",", "TASKREADIN.OPT,TASKREADIN.EXE,TASKFEEDER.OPT,TASKFEEDER.EXE,TASKREADIN.LOG,TASKINPUT_LINES.TXT,TASKINPUT_SHORT.TXT,TASKINPUT_CHARS.TXT,TASKINPUT_TWO.TXT")
$ IF F .EQS. "," THEN GOTO FILES_DONE
$ IF F$SEARCH(F) .NES. "" THEN DELETE/NOLOG 'F';*
$ I = I + 1
$ GOTO NEXT_FILE
$FILES_DONE:
$ EXIT 1
